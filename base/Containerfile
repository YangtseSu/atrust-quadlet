# The aTrust client image: Debian 13, Sangfor's own aTrust package, and the
# plumbing the client expects (X server + VNC, the HTTP and SOCKS5 proxies, the
# iptables/sysctl/getlogin shims). Built into a throwaway local tag by
# publish.yml and consumed by the repository's main Containerfile; it is not
# published on its own. See README.md in this directory for provenance, the
# package derivation and the client-version bump procedure.

FROM debian:trixie-slim AS shims
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*
COPY vendor/fake-getlogin.c vendor/fake-getlogin.mk /tmp/shims/fake-getlogin/
COPY vendor/fake-hwaddr.c vendor/fake-hwaddr.mk /tmp/shims/fake-hwaddr/
RUN make -C /tmp/shims/fake-getlogin -f fake-getlogin.mk \
 && make -C /tmp/shims/fake-hwaddr -f fake-hwaddr.mk

FROM debian:trixie-slim

# The libraries every executable of the client needs but does not ship (derived
# from the DT_NEEDED of the package's 106 ELF files; resources/bin and
# resources/lib carry the rest - boost, thrift, QtSolutions, OpenSSL 1.1, nss).
# Qt5 core/widgets/gui/dbus/network are what aTrustAgent, SdpProgress and the
# plugin libraries link; the gtk/X/atk/atspi/asound/cairo/gbm/cups/drm/expat set
# is the Electron tray's shared-library set; libsystemd0 is needed by the
# package's own libprocps.so.4.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      ca-certificates \
      fonts-wqy-microhei \
      iproute2 iptables \
      libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
      libcairo2 libcups2t64 libdbus-1-3 libdrm2 libexpat1 libfontconfig1 \
      libfreetype6 libgbm1 libgdk-pixbuf-2.0-0 libglib2.0-0t64 libgtk-3-0t64 \
      libpango-1.0-0 libqt5core5a libqt5dbus5 libqt5gui5 libqt5network5 \
      libqt5widgets5 libsystemd0 libx11-6 libx11-xcb1 libxcb1 libxcb-dri3-0 \
      libxcomposite1 libxcursor1 libxdamage1 libxext6 libxfixes3 libxi6 \
      libxkbcommon0 libxkbcommon-x11-0 libxrandr2 libxrender1 libxshmfence1 \
      libxss1 libxtst6 zlib1g \
      microsocks procps psmisc socat tinyproxy-bin \
      tigervnc-standalone-server tigervnc-tools flwm x11-utils xclip stalonetray wget \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# The shims the client needs inside a container, installed before the package
# itself because its postinst (which dpkg -i runs) shells out to loginctl and
# the disposable runtime tools. The sysctl hook makes the client's
# `sysctl -w net.ipv4.conf.utun7.route_localnet=1` succeed where rootless podman
# cannot apply it (the Quadlet unit sets the value on the netns instead);
# dmidecode is pointed at /bin/false so the client cannot read the host's DMI.
# loginctl is this repository's own copy (overlay/): upstream's answered two of
# the four invocation shapes the client's helpers use, see base/README.md.
COPY --from=shims /tmp/shims/fake-getlogin/fake-getlogin.so /usr/local/lib/
COPY --from=shims /tmp/shims/fake-hwaddr/fake-hwaddr.so /usr/local/lib/
COPY vendor/sysctl-hook /usr/sbin/sysctl-hook
COPY overlay/loginctl /usr/bin/loginctl
COPY vendor/xtables-echook-multi /usr/sbin/xtables-echook-multi
RUN sysctl_real="$(command -v sysctl)" \
 && mv "$sysctl_real" /usr/sbin/sysctl.real \
 && ln -s /usr/sbin/sysctl-hook "$sysctl_real" \
 && ln -sf /usr/sbin/sysctl-hook /usr/sbin/sysctl \
 && ln -sf /bin/false /usr/sbin/dmidecode \
 && chmod +x /usr/sbin/sysctl-hook /usr/sbin/xtables-echook-multi /usr/bin/loginctl \
 && echo ATRUST > /etc/vpn-type

# The client, from Sangfor's CDN, verified by sha256 (build-args/ per arch).
# dpkg -i runs the package's own preinst/postinst, so the image carries a
# registered package (`dpkg -l cn.com.sangfor.atrust`); the postinst tolerates
# the missing systemd and logs what it could not do.
ARG ATRUST_VERSION=2.5.16.30
ARG ATRUST_DEB_URL=https://atrustcdn.sangfor.com/standard/linux/2.5.16.30/uos/amd64/aTrustInstaller_amd64.deb
ARG ATRUST_DEB_SHA256=aa8ba93532ae250dcab3d75d3b103fb01a93b97b49cbc6d9066c5ed1f70b75a6
RUN wget -q -O /tmp/aTrust.deb "$ATRUST_DEB_URL" \
 && echo "$ATRUST_DEB_SHA256  /tmp/aTrust.deb" | sha256sum -c - \
 && dpkg -i /tmp/aTrust.deb \
 && rm -f /tmp/aTrust.deb \
 && echo "$ATRUST_VERSION" > /etc/atrust-version

# The runtime plumbing: the detectors and the client prelude/restart loop stay
# byte-identical to upstream (vendor/), start.sh is this repository's aTrust-only
# orchestration (overlay/).
COPY vendor/detect-iptables.sh vendor/detect-route.sh vendor/vpn-config.sh vendor/start-sangfor.sh /usr/local/bin/
COPY vendor/xdg-open /usr/bin/xdg-open
COPY vendor/tinyproxy.conf /etc/tinyproxy.conf
COPY overlay/start.sh /usr/local/bin/start.sh
RUN chmod +x /usr/local/bin/start.sh /usr/local/bin/detect-*.sh \
             /usr/local/bin/vpn-config.sh /usr/local/bin/start-sangfor.sh \
             /usr/bin/xdg-open

ENV PING_INTERVAL=1800

# Brings up the VNC X server, the proxies and the client; the repository's
# entrypoint supervises the login on top of it.
CMD ["/usr/local/bin/start.sh"]
