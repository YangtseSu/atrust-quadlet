# SPDX-FileCopyrightText: 2026 Yangtse Su <yangtsesu@gmail.com>
#
# SPDX-License-Identifier: GPL-3.0-or-later
#
# Quadlet unit: systemctl --user daemon-reload && systemctl --user start atrust.service
# Configuration (portal URL, username, password) lives in the env file below.

[Unit]
Description=aTrust VPN client with supervised auto-login (atrust-quadlet)
Documentation=https://github.com/YangtseSu/atrust-quadlet
# Quadlet's implicit Wants=/After=podman-user-wait-network-online.service is off in [Quadlet] below:
# that helper polls the *system* manager's network-online.target, and on a host where nothing pulls
# the target in it is inactive for the whole boot, so the poll runs into its 90 s timeout on every
# start - measured 2026-10-11: a stop returned in 2 s and the container's `Starting` came 95 s later,
# and the unit's one automatic restart 91 s. Measured 2026-10-15 with the opt-out in place: the same
# `restart` reached `ONLINE` in 15.8 s - 2 s of stop, the container up 0.4 s later, the client's own
# window login 10.7 s in, the tunnel and the first ONLINE cycle 15.8 s in.
# Nothing here needs that order: the supervisor retries the portal login on its own backoff and the
# client retries its own connect.
# An `After=network-online.target` of our own is gone with it: a user unit cannot wait for a system
# unit (systemd#3312), and podman's man page says the target "doesn't do anything there".
# The retry policy below is what carries the starts that cannot succeed yet (no image on a first run,
# no network): systemd's default rate limit (5 starts in 10 s) would end in `Result=start-limit-hit`,
# which only a manual start leaves - measured on a scratch unit with these settings.
StartLimitIntervalSec=0

[Quadlet]
# The opt-out for the implicit dependency named above (podman-systemd.unit(5), [Quadlet] section).
DefaultDependencies=false

[Container]
Image=ghcr.io/yangtsesu/atrust-quadlet:latest
ContainerName=atrust
# The client registers the terminal under the system hostname and the portal's terminal list shows
# it; podman's default is the container ID, i.e. a different hex name in that list on every
# recreation. `%H` is the host's own name, as systemd resolves it when the unit loads; a deployment
# that wants a name of its own overrides the key in atrust.container.d/.
HostName=%H
EnvironmentFile=%h/.config/atrust.env
Environment=ATRUST_STATE_DIR=/run/atrustd
Environment=ATRUST_WATCH_INTERVAL=90

# the client needs its own tun device and the capability to configure it
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
Sysctl=net.ipv4.conf.default.route_localnet=1
ShmSize=256m
# `atrustd` sweeps the client (agent, tunnel, trays) on SIGTERM and exits; this
# caps the wait if the supervisor itself wedges, so a stop costs seconds, not
# podman's default ten
StopTimeout=5

# client profile + atrustd state, so restarts need no new login
Volume=%h/.atrust-data:/root
# the supervisor's state directory on the host too, so quadlet/atrust-notify.sh reads state.json,
# NEED_VNC and the captcha directly (no podman per poll) and their identity survives the container
# being recreated; nothing else depends on this path
Volume=%h/.atrust-data/run:/run/atrustd

# VNC (5901), HTTP proxy (8888), SOCKS5 (1080) - loopback only
PublishPort=127.0.0.1:5901:5901
PublishPort=127.0.0.1:8888:8888
PublishPort=127.0.0.1:1080:1080

[Service]
Restart=always
# `Restart=always` alone retries every 100 ms and reaches the default start limit (5 in 10 s) in two
# seconds; with the limit off above, this is what spaces the retries while a start cannot succeed,
# and it applies to automatic restarts only - a `systemctl --user restart` starts at once.
RestartSec=15s
# The retry policy is what carries a dark start; this is what keeps such a start from being
# pointless: pasta picks its template interface when the container starts and drops to "local mode"
# when the host has no usable route. Measured 2026-10-15 - the sandbox then carries 169.254.2.1/16
# and a default route via pasta's own 169.254.2.2 with nothing behind it (every connect answered
# `ECONNREFUSED` at once), and an address the host gains later never reaches it. So this start is
# held (exit 1; the retry above tries again 15 s later) until the host has a route pasta could use,
# and the rule is pasta's own criterion rather than "online": IPv4 wants a non-loopback route that is
# neither link-local nor a default through a link-local gateway, IPv6 wants a real prefix on a
# non-loopback interface (the default route of a correct host points at a link-local gateway, which
# is exactly the shape pasta's own local-mode tap carries, so it cannot count), and either family is
# enough - an IPv6-only, a static-route-only or a host without a default route passes, a host with
# only a link-local address does not. Fail open: if neither file can be read, the start proceeds.
ExecStartPre=/bin/sh -c 'usable=0; checked=0; if [ -r /proc/net/route ]; then checked=1; { read -r head; while read -r iface dest gateway rest; do case $iface in lo) continue ;; esac; case $dest in *FEA9|FFFFFFFF) continue ;; esac; case $gateway in *FEA9) continue ;; esac; usable=1; break; done; } < /proc/net/route; fi; if [ $usable = 0 ] && [ -r /proc/net/ipv6_route ]; then checked=1; while read -r dest plen src srcplen nexthop metric refcnt use flags iface rest; do case $iface in lo) continue ;; esac; case $plen in 00) continue ;; esac; case $dest in fe8*|fe9*|fea*|feb*|ff*) continue ;; esac; usable=1; break; done < /proc/net/ipv6_route; fi; if [ $usable = 1 ] || [ $checked = 0 ]; then exit 0; fi; echo "atrust: this host has no usable route (nothing outside the container is reachable and pasta would build the sandbox in local mode); holding this start until a route exists, the unit retries every 15 s" >&2; exit 1'
TimeoutStopSec=20

[Install]
WantedBy=default.target
