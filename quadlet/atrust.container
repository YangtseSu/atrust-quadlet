#
# Quadlet unit: systemctl --user daemon-reload && systemctl --user start atrust.service
# Configuration (portal URL, username, password) lives in the env file below.

[Unit]
Description=aTrust VPN client with supervised auto-login (atrust-quadlet)
Documentation=https://github.com/YangtseSu/atrust-quadlet
After=network-online.target

[Container]
Image=ghcr.io/yangtsesu/atrust-quadlet:latest
ContainerName=atrust
# The client registers the terminal under the system hostname and the portal's terminal list shows
# it; podman's default is the container ID, i.e. a different hex name in that list on every
# recreation. `%H` is the host's own name, as systemd resolves it when the unit loads; a deployment
# that wants a name of its own overrides the key in atrust.container.d/.
HostName=%H
EnvironmentFile=%h/.config/atrust.env
Environment=ATRUST_STATE_DIR=/run/atrustd
Environment=ATRUST_WATCH_INTERVAL=90

# the client needs its own tun device and the capability to configure it
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
Sysctl=net.ipv4.conf.default.route_localnet=1
ShmSize=256m
# `atrustd` sweeps the client (agent, tunnel, trays) on SIGTERM and exits; this
# caps the wait if the supervisor itself wedges, so a stop costs seconds, not
# podman's default ten
StopTimeout=5

# client profile + atrustd state, so restarts need no new login
Volume=%h/.atrust-data:/root
# the supervisor's state directory on the host too, so quadlet/atrust-notify.sh reads state.json,
# NEED_VNC and the captcha directly (no podman per poll) and their identity survives the container
# being recreated; nothing else depends on this path
Volume=%h/.atrust-data/run:/run/atrustd

# VNC (5901), HTTP proxy (8888), SOCKS5 (1080) - loopback only
PublishPort=127.0.0.1:5901:5901
PublishPort=127.0.0.1:8888:8888
PublishPort=127.0.0.1:1080:1080

[Service]
Restart=always
TimeoutStopSec=20

[Install]
WantedBy=default.target
