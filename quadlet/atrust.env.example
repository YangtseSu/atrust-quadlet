#
# Copy to ~/.config/atrust.env (chmod 600) and fill in. Referenced by
# ~/.config/containers/systemd/atrust.container as EnvironmentFile=%h/.config/atrust.env

# --- required ---------------------------------------------------------------
ATRUST_PORTAL_URL=https://vpn.example.com/
ATRUST_USERNAME=your-account
ATRUST_PASSWORD=your-password
# or keep the password out of the env file entirely:
# ATRUST_PASSWORD_FILE=%h/.config/atrust-password

# --- VNC password (used by the base image) ----------------------------------
PASSWORD=change-me

# --- optional ---------------------------------------------------------------
# Leave these commented out unless you need them: every one has a working
# default (or none at all) in atrustd/config.py, see the README table.

# Prove the data plane really carries traffic: a host:port reachable ONLY
# through the tunnel, comma separated, the first that answers wins. Unset = the
# tunnel interface plus its routes are the proof (a wrong value here keeps the
# supervisor in DEGRADED and triggers needless client restarts).
# ATRUST_PROBE_TARGET=10.0.0.1:443

# Seconds between supervision cycles (default 90).
# ATRUST_WATCH_INTERVAL=90

# How long to wait for a human in VNC before retrying, seconds (default 900).
# ATRUST_VNC_WAIT=900

# Portal UI language (default zh-CN).
# ATRUST_LANG=zh-CN

# Stable device id sent as x-sdp-env; leave empty to omit.
# ATRUST_DEVICE_ID=00-fffffffffffff0
