#
# Copy to ~/.config/atrust.env (chmod 600) and fill in. Referenced by
# ~/.config/containers/systemd/atrust.container as EnvironmentFile=%h/.config/atrust.env

# --- required ---------------------------------------------------------------
ATRUST_PORTAL_URL=https://vpn.example.com/
ATRUST_USERNAME=your-account
ATRUST_PASSWORD=your-password
# or keep the password out of the env file entirely:
# ATRUST_PASSWORD_FILE=%h/.config/atrust-password

# --- VNC password (used by the base image) ----------------------------------
PASSWORD=change-me

# --- optional ---------------------------------------------------------------
# a host:port reachable only through the tunnel, used to prove the data plane works
ATRUST_PROBE_TARGET=10.0.0.1:443
# seconds between supervision cycles
ATRUST_WATCH_INTERVAL=90
# how long to wait for a human in VNC before retrying (seconds)
ATRUST_VNC_WAIT=900
# portal UI language
ATRUST_LANG=zh-CN
# stable device id sent as x-sdp-env; leave empty to omit
# ATRUST_DEVICE_ID=00-fffffffffffff0
